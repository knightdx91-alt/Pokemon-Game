+// AUTO-GENERATED Pokedex descriptions (PokeAPI: height=dm, weight=hg).
+
+const u8 gRandomDexText_BIDOOF[] = _(
+    "It lives in groups by the water. It\n"
+    "chews up boulders and trees around its\n"
+    "nest with its incisors.");
+const u8 gRandomDexText_BIBAREL[] = _(
+    "Bibarel fur repels water and is also a\n"
+    "fantastic material for heat retention.\n"
+    "These Pokémon create dams on rivers to\n"
+    "live in.");
+const u8 gRandomDexText_KRICKETOT[] = _(
+    "It shakes its head back to front,\n"
+    "causing its antennae to hit each other\n"
+    "and sound like a xylophone.");
+const u8 gRandomDexText_KRICKETUNE[] = _(
+    "It uses its cutlass-like arms to\n"
+    "produce sound, the melody of which\n"
+    "varies from individual to individual.\n"
+    "It is a worthwhile endeavor to seek out");
+const u8 gRandomDexText_BURMY[] = _(
+    "If its cloak is even slightly damaged,\n"
+    "Burmy will immediately repair it with\n"
+    "whatever is close at hand. The Pokémon\n"
+    "within the cloak is scrawny and");
+const u8 gRandomDexText_WORMADAM[] = _(
+    "Its appearance changes depending on\n"
+    "where it evolved. The materials on hand\n"
+    "become a part of its body.");
+const u8 gRandomDexText_MOTHIM[] = _(
+    "Scatters steel-colored scales as it\n"
+    "flaps its wings. Despite being observed\n"
+    "feeding primarily on the nectar of\n"
+    "flowers, Mothim is not often seen");
+const u8 gRandomDexText_COMBEE[] = _(
+    "They swear fealty to a queen Pokémon\n"
+    "and work diligently to gather nectar.\n"
+    "Each swarm produces a different flavor\n"
+    "of honey.");
+const u8 gRandomDexText_VESPIQUEN[] = _(
+    "Commands its subjects to build its\n"
+    "hive. It will dispatch any interlopers\n"
+    "who dare sneak into its nest and use\n"
+    "them as nourishment for itself.");
+const u8 gRandomDexText_PACHIRISU[] = _(
+    "A species related to the Pikachu line.\n"
+    "Though Pachirisu is a calm Pokémon, it\n"
+    "still presents a danger should one\n"
+    "touch its electrified tail or cheeks.");
+const u8 gRandomDexText_BUIZEL[] = _(
+    "It moves freely in the water by\n"
+    "spinning its forked tail for\n"
+    "propulsion. The resemblance to the\n"
+    "screw of a steamboat is coincidental.");
+const u8 gRandomDexText_FLOATZEL[] = _(
+    "Has a long, rather splendid flotation\n"
+    "sac, which prevents Floatzel from\n"
+    "drowning even in stormy seas. One might\n"
+    "glimpse this species around fishing");
+const u8 gRandomDexText_GLAMEOW[] = _(
+    "Bewitches humans with its helical tail\n"
+    "and piercing gaze. Its hidden claws are\n"
+    "quite sharp as well, making this\n"
+    "Pokémon an exceedingly tricky opponent");
+const u8 gRandomDexText_PURUGLY[] = _(
+    "Though impudent and difficult to tame,\n"
+    "Purugly enjoys great popularity due to\n"
+    "its fur, the beauty of which surpasses\n"
+    "even velveteen.");
+const u8 gRandomDexText_CHINGLING[] = _(
+    "It emits high-frequency cries that\n"
+    "people can't hear. Once it starts, it\n"
+    "can cry for an awfully long time.");
+const u8 gRandomDexText_STUNKY[] = _(
+    "The poison that gushes from its aft end\n"
+    "is accompanied by an utterly\n"
+    "evil-smelling odor with such potency\n"
+    "that one whiff can induce memory loss.");
+const u8 gRandomDexText_SKUNTANK[] = _(
+    "Sprays a poisonous fluid to take down\n"
+    "prey. Sometimes, unable to stomach the\n"
+    "stench of its own fluid, it leaves the\n"
+    "bested prey uneaten.");
+const u8 gRandomDexText_BRONZOR[] = _(
+    "Polishing Bronzor to a shine makes its\n"
+    "surface reflect the truth, according to\n"
+    "common lore. Be that as it may, Bronzor\n"
+    "hates being polished.");
