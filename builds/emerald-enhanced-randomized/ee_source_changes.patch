+// Returns TRUE only for species that are safe to encounter/register: a real
+// species (nonzero base HP), with a National Dex number that has a valid
+// Pokedex entry (non-NULL description). This guarantees every wild/starter mon
+// can be shown in the Pokedex without the info screen hanging.
+bool8 RyuIsSpeciesDexSafe(u16 species)
+{
+    u16 dexNum;
+
+    if (species == SPECIES_NONE || species >= NUM_SPECIES)
+        return FALSE;
+    if (gBaseStats[species].baseHP == 0)
+        return FALSE;
+    dexNum = SpeciesToNationalPokedexNum(species);
+    if (dexNum == 0)
+        return FALSE;
+    if (gPokedexEntries[dexNum].description == NULL)
+        return FALSE;
+    return TRUE;
+}
+
+// Picks a fully-random species that is guaranteed dex-safe.
+u16 RyuGetRandomSafeSpecies(void)
+{
+    u16 species;
+    u16 tries;
+
+    for (tries = 0; tries < 512; tries++)
+    {
+        species = (Random() % (NUM_SPECIES - 1)) + 1;
+        if (RyuIsSpeciesDexSafe(species))
+            return species;
+    }
+    return SPECIES_ZIGZAGOON; // guaranteed-valid fallback
+}
+
+// Deterministic per-save random starter for a given slot. Seeded from the
+// player's trainer ID so the displayed sprite, cry, and received mon all match
+// and stay consistent for the whole playthrough, while differing between saves.
+u16 RyuGetRandomStarterSpecies(u8 slot)
+{
+    u32 seed = T1_READ_32(gSaveBlock2Ptr->playerTrainerId) ^ (0x9E3779B1u * (slot + 1));
+    u16 species;
+    u16 tries;
+
+    for (tries = 0; tries < 4096; tries++)
+    {
+        seed = seed * 1103515245u + 12345u;
+        species = ((seed >> 16) % (NUM_SPECIES - 1)) + 1;
+        if (RyuIsSpeciesDexSafe(species))
+            return species;
+    }
+    return SPECIES_MUDKIP; // guaranteed-valid fallback
+}
