+static void HookRecordWatch(u32 vaddr, const u32* regs) {
+    if (std::FILE* f = std::fopen("/tmp/hook_out", "a")) {
+        std::fprintf(f, "%08x", vaddr);
+        for (int i = 0; i < 16; ++i)
+            std::fprintf(f, " %08x", regs[i]);
+        std::fprintf(f, "\n");
+        std::fclose(f);
+    }
+    g_hook_count.fetch_add(1);
+}
