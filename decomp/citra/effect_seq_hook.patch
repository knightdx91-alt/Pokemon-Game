+void ApDumpFrame(SDL_Window* win, long frame) {
+    int w = 0, h = 0;
+    SDL_GetWindowSize(win, &w, &h);
+    if (w <= 0 || h <= 0) {
+        return;
+    }
+    std::vector<unsigned char> buf(static_cast<std::size_t>(w) * h * 3);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glReadPixels(0, 0, w, h, GL_RGB, GL_UNSIGNED_BYTE, buf.data());
+    char path[256];
+    std::snprintf(path, sizeof(path), "/tmp/frames/f%06ld.ppm", frame);
+    std::FILE* f = std::fopen(path, "wb");
+    if (!f) {
+        return;
+    }
+    std::fprintf(f, "P6\n%d %d\n255\n", w, h);
+    for (int y = h - 1; y >= 0; --y) { // GL origin is bottom-left; flip vertically
+        std::fwrite(&buf[static_cast<std::size_t>(y) * w * 3], 1, static_cast<std::size_t>(w) * 3, f);
+    }
+    std::fclose(f);
+}
+
+// ---- Live interactive control (frame-by-frame see->act driving) -------------
+// /tmp/ap_key: lines "<down> <scancode>" applied immediately then file removed.
+// /tmp/shot   : dump the current framebuffer to /tmp/frames/live.ppm now.
+void ApLiveInput() {
+    std::ifstream in("/tmp/ap_key");
