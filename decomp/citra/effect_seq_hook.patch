+// Dump a slice of the running app's VIRTUAL address space (VA-contiguous), so the
+// CRO cluster (static.crs + all .cro modules incl. Battle.cro) can be read at its
+// real VAs — a physical FCRAM dump is scattered by the MMU and can't locate .bss.
+// Trigger: /tmp/dump_va (optional "hexbase hexsize"; default 0x00100000 0x00F00000).
+void ApMaybeDumpVa() {
+    std::ifstream trig("/tmp/dump_va");
+    if (!trig) {
+        return;
+    }
+    unsigned long base = 0x00100000UL, size = 0x00F00000UL;
+    {
+        std::string s((std::istreambuf_iterator<char>(trig)), std::istreambuf_iterator<char>());
+        std::sscanf(s.c_str(), "%lx %lx", &base, &size);
+    }
+    trig.close();
+    std::remove("/tmp/dump_va");
+    auto& sys = Core::System::GetInstance();
+    if (!sys.IsPoweredOn()) {
+        return;
+    }
+    auto proc = sys.Kernel().GetCurrentProcess();
+    if (!proc) {
+        return;
+    }
+    std::vector<u8> buf(size, 0);
+    sys.Memory().ReadBlock(*proc, static_cast<u32>(base), buf.data(), size);
+    if (std::FILE* f = std::fopen("/tmp/va.bin", "wb")) {
+        std::fwrite(buf.data(), 1, size, f);
+        std::fclose(f);
+    }
+    // record the base so the reader knows the VA origin
+    if (std::FILE* m = std::fopen("/tmp/va.meta", "wb")) {
+        std::fprintf(m, "%lx %lx\n", base, size);
+        std::fclose(m);
+    }
+    if (std::FILE* d = std::fopen("/tmp/va.done", "wb")) {
+        std::fclose(d);
+    }
+}
