+// decomp research: arm/disarm the JIT read-watch (see arm_dynarmic.cpp).
+// /tmp/hook_arm contains "lo hi" (hex VA range); /tmp/hook_disarm clears it.
+void ApMaybeHook() {
+    if (std::ifstream trig{"/tmp/hook_arm"}) {
+        unsigned long lo = 0, hi = 0;
+        std::string s((std::istreambuf_iterator<char>(trig)), std::istreambuf_iterator<char>());
+        trig.close();
+        std::remove("/tmp/hook_arm");
+        if (std::sscanf(s.c_str(), "%lx %lx", &lo, &hi) == 2) {
+            g_hook_lo.store(static_cast<u32>(lo));
+            g_hook_hi.store(static_cast<u32>(hi));
+            if (std::FILE* d = std::fopen("/tmp/hook_armed", "wb")) {
+                std::fprintf(d, "%lx %lx\n", lo, hi);
+                std::fclose(d);
+            }
+        }
+    }
+    if (std::FILE* t = std::fopen("/tmp/hook_disarm", "rb")) {
+        std::fclose(t);
+        std::remove("/tmp/hook_disarm");
+        g_hook_lo.store(0);
+        g_hook_hi.store(0);
+    }
+}
