+            InputCommon::GetKeyboard()->PressKey(sc);
+        } else {
+            InputCommon::GetKeyboard()->ReleaseKey(sc);
+        }
+    }
+    in.close();
+    std::remove("/tmp/ap_key");
+    std::FILE* d = std::fopen("/tmp/ap_key.done", "wb");
+    if (d) {
+        std::fclose(d);
+    }
+}
+
+void ApLiveShot(SDL_Window* win) {
+    if (!std::fopen("/tmp/shot", "rb")) {
+        return;
+    }
+    std::remove("/tmp/shot");
+    int w = 0, h = 0;
+    SDL_GetWindowSize(win, &w, &h);
+    if (w <= 0 || h <= 0) {
+        return;
+    }
+    std::vector<unsigned char> buf(static_cast<std::size_t>(w) * h * 3);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glReadPixels(0, 0, w, h, GL_RGB, GL_UNSIGNED_BYTE, buf.data());
+    std::FILE* f = std::fopen("/tmp/frames/live.ppm", "wb");
+    if (f) {
+        std::fprintf(f, "P6\n%d %d\n255\n", w, h);
+        for (int y = h - 1; y >= 0; --y) {
+            std::fwrite(&buf[static_cast<std::size_t>(y) * w * 3], 1,
+                        static_cast<std::size_t>(w) * 3, f);
+        }
+        std::fclose(f);
+    }
+    std::FILE* d = std::fopen("/tmp/shot.done", "wb");
+    if (d) {
+        std::fclose(d);
+    }
+}
