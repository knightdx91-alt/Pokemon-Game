+// decomp research: file-based guest-memory poke (write). /tmp/poke holds one or
+// more lines "<hexaddr> <hexval> <size>" (size = 1/2/4 bytes; default 2). Applied
+// once then the file is removed; writes /tmp/poke.done. Used to weaken the lead
+// (battlemon level @+0x18 = 1) so wild mons survive a hit and the secondary-effect
+// sequence actually runs for the effect->seq capture.
+void ApMaybePoke() {
+    std::ifstream trig("/tmp/poke");
+    if (!trig) {
+        return;
+    }
+    std::string all((std::istreambuf_iterator<char>(trig)), std::istreambuf_iterator<char>());
+    trig.close();
+    std::remove("/tmp/poke");
+    auto& sys = Core::System::GetInstance();
+    if (!sys.IsPoweredOn()) {
+        return;
+    }
+    auto proc = sys.Kernel().GetCurrentProcess();
+    if (!proc) {
+        return;
+    }
+    std::istringstream in(all);
+    std::string line;
+    int n = 0;
+    while (std::getline(in, line)) {
+        unsigned long addr = 0, val = 0, size = 2;
+        if (std::sscanf(line.c_str(), "%lx %lx %lx", &addr, &val, &size) < 2) {
+            continue;
+        }
+        auto& mem = sys.Memory();
+        if (size == 1) {
+            mem.Write8(static_cast<u32>(addr), static_cast<u8>(val));
+        } else if (size == 4) {
+            mem.Write32(static_cast<u32>(addr), static_cast<u32>(val));
+        } else {
+            mem.Write16(static_cast<u32>(addr), static_cast<u16>(val));
+        }
+        ++n;
+    }
+    if (std::FILE* d = std::fopen("/tmp/poke.done", "wb")) {
+        std::fprintf(d, "%d\n", n);
+        std::fclose(d);
+    }
+}
