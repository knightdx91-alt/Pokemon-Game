+void EmuWindow_SDL2::SwapBuffers() {
+    // Synchronous-renderer model: the GPU emulation thread drives frame
+    // composition via g_renderer->SwapBuffers(), which calls this to present
+    // the finished frame. (This fork's video_core has no threaded Present.)
+    static const bool ap_enabled = std::getenv("CITRA_AUTOPILOT") != nullptr;
+    if (ap_enabled) {
+        static long ap_frame = -1;
+        static const long shot_every = [] {
+            const char* s = std::getenv("CITRA_SHOT_EVERY");
+            const long v = s ? std::atol(s) : 30;
+            return v > 0 ? v : 30;
+        }();
+        ++ap_frame;
+        ApTick(ap_frame);
+        ApLiveInput();
+        ApLiveShot(render_window);
+        ApMaybeHook();
+        ApMaybePoke();
+        ApMaybeState();
+        ApMaybeDumpFcram();
+        ApMaybeDumpVa();
+        if (ap_frame % shot_every == 0) {
+            ApDumpFrame(render_window, ap_frame);
+        }
+    }
+    SDL_GL_SwapWindow(render_window);
 }
 
