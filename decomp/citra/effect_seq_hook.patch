+// Copyright 2019 Citra Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+//
+// Recreated for the StonedEdge/citra-1 build (fix #2): the frontends reference
+// this header but it is missing from the tree. Small RAII wrapper that makes a
+// graphics context current for the object's lifetime. EmuWindow derives from
+// GraphicsContext (fix #3), so `ScopeAcquireContext scope(*emu_window);` binds
+// to the GraphicsContext& overload.
+
+#pragma once
+
+#include "core/frontend/emu_window.h"
+
+namespace Frontend {
+
+class ScopeAcquireContext {
+public:
+    explicit ScopeAcquireContext(GraphicsContext& context) : context{context} {
+        context.MakeCurrent();
+    }
+    ~ScopeAcquireContext() {
+        context.DoneCurrent();
+    }
+
+    ScopeAcquireContext(const ScopeAcquireContext&) = delete;
+    ScopeAcquireContext& operator=(const ScopeAcquireContext&) = delete;
+
+private:
+    GraphicsContext& context;
+};
+
+} // namespace Frontend
