+// Save/load Citra save states via trigger files, so a driver can checkpoint
+// after the slow boot+load and cheaply branch navigation attempts.
+// /tmp/save_state -> SaveState(1); /tmp/load_state -> LoadState(1). Runs on the
+// emu thread (synchronous renderer), i.e. between frames.
+void ApMaybeState() {
+    if (!Core::System::GetInstance().IsPoweredOn()) {
+        return;
+    }
+    if (std::FILE* t = std::fopen("/tmp/save_state", "rb")) {
+        std::fclose(t);
+        std::remove("/tmp/save_state");
+        Core::System::GetInstance().SaveState(1);
+        if (std::FILE* d = std::fopen("/tmp/save_state.done", "wb")) {
+            std::fclose(d);
+        }
+    }
+    if (std::FILE* t = std::fopen("/tmp/load_state", "rb")) {
+        std::fclose(t);
+        std::remove("/tmp/load_state");
+        Core::System::GetInstance().LoadState(1);
