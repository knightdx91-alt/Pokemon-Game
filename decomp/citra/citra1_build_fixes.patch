diff --git a/src/core/frontend/scope_acquire_context.h b/src/core/frontend/scope_acquire_context.h
new file mode 100644
index 0000000..fb6bae3
--- /dev/null
+++ b/src/core/frontend/scope_acquire_context.h
@@ -0,0 +1,36 @@
+// Copyright 2019 Citra Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include "common/common_types.h"
+
+namespace Frontend {
+
+/// RAII helper that makes a rendering context current for the lifetime of the
+/// object and releases it on destruction. Templated so it accepts either an
+/// EmuWindow or a GraphicsContext (both expose MakeCurrent()/DoneCurrent()).
+template <typename Context>
+class ScopeAcquireContext {
+public:
+    explicit ScopeAcquireContext(Context& context_) : context{context_} {
+        context.MakeCurrent();
+    }
+    ~ScopeAcquireContext() {
+        context.DoneCurrent();
+    }
+
+    ScopeAcquireContext(const ScopeAcquireContext&) = delete;
+    ScopeAcquireContext& operator=(const ScopeAcquireContext&) = delete;
+
+private:
+    Context& context;
+};
+
+// Deduction guide so `ScopeAcquireContext scope(*emu_window);` works without
+// spelling out the template argument at the call sites.
+template <typename Context>
+ScopeAcquireContext(Context&) -> ScopeAcquireContext<Context>;
+
+} // namespace Frontend
